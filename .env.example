# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment (Vite). Copy to `.env` and fill in.
# Server-side secrets (service-role key, Anthropic, Stripe secret, Resend) live
# on the Supabase Edge Functions — NEVER here, and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# Required for a full (Level B) run. Without these the app shows a setup screen
# (there is no offline/demo auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Optional: Level A (no-secrets UI review) ────────────────────────────────
# Dev-only screen gallery when Supabase is unset (UI previews only; no sign-in).
# VITE_SHOW_DEV_GALLERY=true
# VITE_SHOW_SAMPLE_INTAKE=true

# ── Optional feature flags ──────────────────────────────────────────────────
# VITE_ENABLE_PARTICIPATING_ROUTING=true

# ── Optional: Stripe price IDs (client-side; only needed for the paid-plan UI)
# Flat 4-tier model (decided direction 2026-08-06): Starter + Underwriting Low/Mid/High.
# Each tier has a monthly and an annual price (annual = 2 months free).
# VITE_STRIPE_PRICE_STARTER_MONTHLY=
# VITE_STRIPE_PRICE_STARTER_ANNUAL=
# VITE_STRIPE_PRICE_UNDERWRITING_LOW_MONTHLY=
# VITE_STRIPE_PRICE_UNDERWRITING_LOW_ANNUAL=
# VITE_STRIPE_PRICE_UNDERWRITING_MID_MONTHLY=
# VITE_STRIPE_PRICE_UNDERWRITING_MID_ANNUAL=
# VITE_STRIPE_PRICE_UNDERWRITING_HIGH_MONTHLY=
# VITE_STRIPE_PRICE_UNDERWRITING_HIGH_ANNUAL=

# ── Optional: Sentry error monitoring (src/lib/sentry.ts) ───────────────────
# Write-only ingest DSN — safe to store as a plain env var, not a secret to guard
# like an API key. Unset = Sentry never initializes (dev default).
# VITE_SENTRY_DSN=
